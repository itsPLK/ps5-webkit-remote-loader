# Shared PS5 SDK build recipe. GPLv3; see installer/LICENSE.
# Dockerfile to build the ps5-payload-dev/sdk environment locally
FROM ubuntu:24.04

# Install dependencies
# Clang 18 and LLD 18 are required by the SDK
# librsvg2-bin provides rsvg-convert for build-time icon asset generation
# nodejs/npm (Ubuntu 24.04 ships Node 18.19, satisfying LuaK1t's >=18 requirement)
# build the bundled Lua runtime (tools/lua_runtime/build_runtime.py)
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    ninja-build \
    clang-18 \
    lld-18 \
    make \
    python3 \
    python3-pyelftools \
    wget \
    xz-utils \
    pkg-config \
    sudo \
    unzip \
    librsvg2-bin \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Set up Clang 18 as default
RUN ln -s /usr/bin/clang-18 /usr/bin/clang && \
    ln -s /usr/bin/clang++-18 /usr/bin/clang++ && \
    ln -s /usr/bin/ld.lld-18 /usr/bin/ld.lld

# Set up environment
WORKDIR /opt

# Clone the SDK
RUN git clone https://github.com/ps5-payload-dev/sdk.git ps5-payload-sdk-source

# Build and Install the SDK to /opt/ps5-payload-sdk
WORKDIR /opt/ps5-payload-sdk-source
RUN make DESTDIR=/opt/ps5-payload-sdk install

# Build dependencies for PS5 using the SDK (libmicrohttpd)
WORKDIR /opt
COPY build_deps.sh /opt/build_deps.sh
RUN bash /opt/build_deps.sh

# Set the environment variables for subsequent builds
ENV PS5_PAYLOAD_SDK=/opt/ps5-payload-sdk
# build_release.sh runs this image with -u <host-uid>:<host-gid>, a UID with no
# /etc/passwd entry, so $HOME resolves to "/" and npm's cache dir (~/.npm)
# isn't writable. Point HOME at /tmp, which is world-writable regardless of UID.
ENV HOME=/tmp
WORKDIR /src
